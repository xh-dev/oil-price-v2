# syntax=docker/dockerfile:1
# Generated by `oil-price-v2 gen-dockerfile`. Build from the project root:
#   docker build -t oil-price-v2 .
#   docker run -d -p {{ port }}:{{ port }} oil-price-v2        # then open http://localhost:{{ port }}/
{% if build_site %}
# The page is generated while the image is built (stage "builder"), so building needs network access.
# Default decoder: rules (no AI). To use an LLM at build time, for example an Ollama on the host:
#   docker build -t oil-price-v2 --add-host=host.docker.internal:host-gateway \
#     --build-arg OIL_PRICE_DECODER=llm --build-arg OIL_PRICE_LLM_PROVIDER=ollama \
#     --build-arg OIL_PRICE_LLM_MODEL=<model> --build-arg OIL_PRICE_LLM_BASE_URL=http://host.docker.internal:11434 .
# The page is not updated by itself: rebuild the image regularly (cron, CI) to refresh it.
FROM python:{{ python_version }}-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Dependencies first, so this layer is cached until requirements.txt changes.
COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-deps .

ARG OIL_PRICE_DECODER=rules
ARG OIL_PRICE_LLM_PROVIDER=
ARG OIL_PRICE_LLM_MODEL=
ARG OIL_PRICE_LLM_BASE_URL=
RUN oil-price-v2 refresh --decoder "${OIL_PRICE_DECODER}" --work-dir /build/data --out-dir /build/site

{% else %}
# The page is the generated `site/` directory (run `oil-price-v2 refresh` first). The image is only nginx,
# so it can be built anywhere, and rebuilt whenever `site/` changes.
{% endif %}
FROM nginx:alpine

COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen {{ port }};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/json text/plain application/javascript;

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }
}
EOF

{% if build_site %}
COPY --from=builder /build/site/ /usr/share/nginx/html/
{% else %}
COPY site/ /usr/share/nginx/html/
{% endif %}
# Files copied from the host keep the host's mode; make sure nginx can read them.
RUN chmod -R a+rX /usr/share/nginx/html

EXPOSE {{ port }}

HEALTHCHECK --interval=1m --timeout=5s --start-period=5s \
  CMD wget -q -O /dev/null http://127.0.0.1:{{ port }}/ || exit 1





